@PACKAGE_INIT@

# vox4c::vox4c  header only - define VOX4C_IMPLEMENTATION in one source file
# vox4c::lib    static library with the implementation (if it was built)
#
#   find_package(vox4c CONFIG REQUIRED)
#   target_link_libraries(my_app PRIVATE vox4c::vox4c)   # or vox4c::lib

set(vox4c_HAS_LIBRARY @VOX4C_CONFIG_HAS_LIBRARY@)
# MSVC runtime the static library was built with: MD (/MD, /MDd) or MT (/MT, /MTd)
set(vox4c_MSVC_RUNTIME "@VOX4C_CONFIG_MSVC_RUNTIME@")

include("${CMAKE_CURRENT_LIST_DIR}/vox4cTargets.cmake")

# A static library must use the same MSVC runtime as the program it is linked
# into (otherwise LNK2038 / LNK4098); warn early when that is clearly not the case.
if(vox4c_HAS_LIBRARY AND vox4c_MSVC_RUNTIME AND DEFINED CMAKE_MSVC_RUNTIME_LIBRARY)
    if(CMAKE_MSVC_RUNTIME_LIBRARY MATCHES "DLL")
        set(_vox4c_consumer_runtime MD)
    else()
        set(_vox4c_consumer_runtime MT)
    endif()
    if(NOT _vox4c_consumer_runtime STREQUAL vox4c_MSVC_RUNTIME)
        message(WARNING "vox4c::lib was built with /${vox4c_MSVC_RUNTIME} but this project uses "
                        "/${_vox4c_consumer_runtime} (CMAKE_MSVC_RUNTIME_LIBRARY). Linking vox4c::lib will fail; "
                        "rebuild vox4c with -DVOX4C_MSVC_RUNTIME=${_vox4c_consumer_runtime} or use vox4c::vox4c.")
    endif()
    unset(_vox4c_consumer_runtime)
endif()

check_required_components(vox4c)
