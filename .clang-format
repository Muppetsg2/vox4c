# vox4c code style (clang-format 14+)
#
# Matches the existing code: 4 spaces, Allman braces, 120 columns, pointers
# attached to the type ("v4c_scene* s"), consecutive declarations and
# assignments aligned.
#
#   clang-format -i vox4c.h src/*.c tests/*.c tests/*.cpp examples/*.c
#
# Regions that are laid out by hand (tables, the default palette) are wrapped
# in "// clang-format off" / "// clang-format on" or "/* clang-format off */".
Language: Cpp
BasedOnStyle: LLVM
Standard: c++11                     # the header is also compiled as C++

ColumnLimit: 120
IndentWidth: 4
TabWidth: 4
UseTab: Never
ContinuationIndentWidth: 4

BreakBeforeBraces: Custom           # Allman, except 'extern "C" {'
BraceWrapping:
  AfterCaseLabel: true
  AfterClass: true
  AfterControlStatement: Always
  AfterEnum: true
  AfterFunction: true
  AfterNamespace: true
  AfterStruct: true
  AfterUnion: true
  AfterExternBlock: false
  BeforeCatch: true
  BeforeElse: true
  BeforeWhile: false
  SplitEmptyFunction: true
  SplitEmptyRecord: true
IndentCaseLabels: false
IndentPPDirectives: None            # nested "#  define" inside #if blocks are written by hand
IndentExternBlock: NoIndent
NamespaceIndentation: None

PointerAlignment: Left
DerivePointerAlignment: false

AlignConsecutiveAssignments: Consecutive
AlignConsecutiveDeclarations: Consecutive
AlignConsecutiveMacros: Consecutive
AlignTrailingComments: true
AlignEscapedNewlines: Left
AlignOperands: Align
AlignAfterOpenBracket: Align

AllowShortFunctionsOnASingleLine: Inline
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortBlocksOnASingleLine: Never
AllowShortCaseLabelsOnASingleLine: true
AllowShortEnumsOnASingleLine: false
AllowAllArgumentsOnNextLine: true
AllowAllParametersOfDeclarationOnNextLine: true
BinPackArguments: true
BinPackParameters: true

AlwaysBreakAfterReturnType: None
BreakBeforeBinaryOperators: None
BreakBeforeTernaryOperators: true
BreakStringLiterals: false

SpaceAfterCStyleCast: false
SpaceBeforeParens: ControlStatements
SpacesBeforeTrailingComments: 1
Cpp11BracedListStyle: false         # "{ 1, 2, 3 }" as in the C sources
MaxEmptyLinesToKeep: 1
KeepEmptyLinesAtTheStartOfBlocks: false

SortIncludes: Never                 # vox4c.h must come first, order is deliberate
ReflowComments: false               # the ASCII tables in comments stay as written
InsertNewlineAtEOF: true
