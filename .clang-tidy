# clang-tidy configuration for vox4c (C99 single-header library, clang-tidy 14+)
#
# Run through CMake:  -DVOX4C_ENABLE_CLANG_TIDY=ON, then the clang_tidy_<target>
# targets (see README.md). The implementation lives in vox4c.h, so the header
# is checked through the translation units that define VOX4C_IMPLEMENTATION.
#
# Only checks that apply to C are enabled (no modernize-, cppcoreguidelines-,
# hicpp-, google-, fuchsia-, llvm-, ...). Disabled checks have a reason below.
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-assignment-in-if-condition,
  -bugprone-multi-level-implicit-pointer-conversion,
  cert-*,
  -cert-err33-c,
  -cert-dcl37-c,
  -cert-dcl51-cpp,
  clang-analyzer-*,
  -clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling,
  -clang-analyzer-security.insecureAPI.strcpy,
  misc-*,
  -misc-include-cleaner,
  -misc-no-recursion,
  -misc-unused-parameters,
  performance-*,
  portability-*,
  readability-*,
  -readability-braces-around-statements,
  -readability-identifier-length,
  -readability-isolate-declaration,
  -readability-magic-numbers,
  -readability-uppercase-literal-suffix,
  -readability-function-cognitive-complexity,
  -readability-avoid-unconditional-preprocessor-if,
  -readability-avoid-nested-conditional-operator,
  -readability-math-missing-parentheses

# Why the checks above are off:
#   easily-swappable-parameters   (x, y, z) / (width, height) parameters are the domain
#   assignment-in-if-condition    "if ((v = v4c__dict_get(...)) != NULL)" is the dictionary idiom
#   multi-level-implicit-pointer  free(void*) on T** arrays
#   cert-err33-c                  printf / fclose results in the examples and tests
#   cert-dcl37-c, cert-dcl51-cpp  "v4c__" prefixes contain a double underscore (reserved only in C++);
#                                 the library uses it for internal names on purpose
#   insecureAPI.*                 memcpy / memset / snprintf are bounds checked by the code;
#                                 the *_s replacements are not portable C99
#   include-cleaner               single-header library: includes are deliberate
#   no-recursion                  the scene graph is walked recursively, with a depth limit
#   unused-parameters             public callbacks / C API stability
#   braces-around-statements      single statement bodies without braces are the code style
#   identifier-length, isolate-declaration, magic-numbers, uppercase-literal-suffix
#                                 short math names (x, y, d, k), "uint32_t i, j;", file format
#                                 constants, 1u / 0.5f literals
#   function-cognitive-complexity the parser and the mesher are long state machines
#   avoid-unconditional-pp-if     "#if 0" blocks are not used, but config macros are
#   avoid-nested-conditional-op, math-missing-parentheses
#                                 style preferences that conflict with the existing code

WarningsAsErrors: ''
HeaderFilterRegex: '.*vox4c\.h'
FormatStyle: file

CheckOptions:
  - key: readability-function-size.LineThreshold
    value: '400'
  - key: readability-function-size.StatementThreshold
    value: '800'
  - key: readability-function-size.NestingThreshold
    value: '6'
  - key: readability-implicit-bool-conversion.AllowIntegerConditions
    value: 'true'
  - key: readability-implicit-bool-conversion.AllowPointerConditions
    value: 'true'
  - key: bugprone-narrowing-conversions.WarnOnIntegerToFloatingPointNarrowingConversion
    value: 'false'
  - key: bugprone-narrowing-conversions.WarnOnFloatingPointNarrowingConversion
    value: 'false'
  - key: misc-non-private-member-variables-in-classes.IgnoreClassesWithAllMemberVariablesBeingPublic
    value: 'true'
